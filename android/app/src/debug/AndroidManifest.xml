<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application android:name=".DebugDshmApplication" android:label="@string/debug_app_label" tools:replace="android:name,android:label">
        <activity android:name=".RemoteSaveProbeActivity" android:exported="false" />
        <activity android:name=".RemoteShareFeedProbeActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true" />
        <provider android:name=".RemoteSaveProbeProvider" android:authorities="${applicationId}.saveprobe"
            android:exported="true" android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <activity android:name=".ComputerKeyProbeActivity" android:exported="false" />
        <activity android:name=".NativeInputProbeActivity" android:exported="true"
            android:label="DSHM 原生输入对照（调试）"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
